# Origin of the pop-ladle backend (no trailing slash). Read at build time for the
# /api rewrites and at request time by /confirm-email. Blank = the forms show
# "The signup service is being connected."
API_URL=http://localhost:9000

# Private-preview password gate, the same backend gate and password as the old
# site (pop-ladle's FRONTEND_GATE_PASSWORD). On only when exactly "true". Both
# values are baked in at build time, so redeploy after changing them.
NEXT_PUBLIC_ACCESS_GATE_ENABLED=
# Where the gate calls the backend. Blank = same-origin /api/v1 through the
# rewrite (needs API_URL). Production: https://api.popladle.com/api/v1
NEXT_PUBLIC_API_BASE_URL=

# Public origin of this site, used for absolute Open Graph image URLs.
SITE_URL=http://localhost:3000

# Optional tags. They load only after a visitor accepts that cookie category.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
